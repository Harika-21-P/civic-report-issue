# Neon pooled URL for app traffic. Never prefix database URLs with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct URL for Prisma schema-management commands.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-NEON-HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Change this to a long random value before deployment; it signs login cookies.
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Optional: used only by the server-side seed script. Defaults are for local demos only.
ADMIN_EMAIL="admin011@gmail.com"
ADMIN_PASSWORD="admin@123"
ROAD_STAFF_PASSWORD="road@123"
ELECTRICAL_STAFF_PASSWORD="electrical@123"
WATER_STAFF_PASSWORD="water@123"
WASTE_STAFF_PASSWORD="waste@123"
DRAINAGE_STAFF_PASSWORD="drainage@123"
